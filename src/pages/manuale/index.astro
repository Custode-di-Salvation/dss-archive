---
import { getCollection } from 'astro:content';

const allPages = await getCollection('manuale');
const sortedPages = allPages.sort((a, b) => a.data.ordine - b.data.ordine);

if (sortedPages.length > 0) {
  return Astro.redirect(`/manuale/${sortedPages[0].id}/`);
}
---
<p>Nessun manuale disponibile.</p>
